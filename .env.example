# ==============================================================================
# TrafficLens-AI Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=TrafficLens-AI
VERSION=0.1.0

# Database Configuration
# Default: SQLite file in local repository root
DATABASE_URL=sqlite:///./trafficlens.db
DB_ECHO=false

# Media & Storage Paths
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs
MAX_UPLOAD_SIZE_BYTES=524288000

# Computer Vision Inference Parameters (Frozen Baselines)
YOLO_MODEL_PATH=yolo11n.pt
INFERENCE_DEVICE=cpu
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# ByteTrack Multi-Object Tracking Parameters
TRACK_HIGH_THRESH=0.40
TRACK_LOW_THRESH=0.10
NEW_TRACK_THRESH=0.50
MATCH_THRESH=0.70
TRACK_BUFFER=45

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==============================================================================
# Vision-Language Model (VLM) Scene Interpretation (Milestone 5C)
# ==============================================================================
# Master toggle: set to true to enable multimodal VLM scene understanding
VLM_ENABLED=false

# Active provider: "gemini" (Google Gemini REST API), "mock" (offline deterministic testing), or "openai_compatible"
VLM_PROVIDER_TYPE=gemini

# Google Gemini API Settings (Native generateContent REST API)
# API key is authenticated via 'x-goog-api-key' header and never logged or exposed.
# To obtain a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model: explicitly configurable.
# Example model: "gemini-2.5-flash" (or "gemini-1.5-flash" / "gemini-2.0-flash")
GEMINI_MODEL=gemini-2.5-flash

# Base URL for Google Generative Language REST API
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Inference Hyperparameters & Resilience
VLM_REQUEST_TIMEOUT=30.0
VLM_MAX_RETRIES=2
VLM_MAX_OUTPUT_TOKENS=2048
VLM_TEMPERATURE=0.2

# LangGraph Incident Agent Settings
INCIDENT_AGENT_TIMEOUT=30.0
